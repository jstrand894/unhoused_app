#!/bin/bash
# On every commit, raise the patch version in hobo/version.json (1.0.0 -> 1.0.1 ...) and move the notes in its
# "pending" list into a new "history" entry for that version. Skipped if HOBO_NO_BUMP=1.
# If you already changed "version" by hand since the last commit (e.g. 1.1.0), that version is kept.
set -e
FILE="hobo/version.json"
[ -n "$HOBO_NO_BUMP" ] && exit 0
[ -f "$FILE" ] || exit 0
committed=$(git show "HEAD:$FILE" 2>/dev/null || true)
FILE="$FILE" COMMITTED="$committed" python3 - <<'PY'
import json, os, datetime
path = os.environ["FILE"]
data = json.load(open(path))
current = data["version"]
try:
    committed = json.loads(os.environ["COMMITTED"])["version"]
except Exception:
    committed = None
if committed is not None and current != committed:
    new = current                                   # bumped by hand: respect it
else:
    major, minor, patch = current.split(".")
    new = f"{major}.{minor}.{int(patch) + 1}"
data["version"] = new
if not data["history"] or data["history"][0]["version"] != new:
    notes = data.get("pending") or ["Small fixes and improvements."]
    data["history"].insert(0, {"version": new, "date": datetime.date.today().isoformat(), "changes": notes})
    data["pending"] = []
with open(path, "w") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
    f.write("\n")
print(f"version bumped: {current} -> {new}")
PY
git add "$FILE"
